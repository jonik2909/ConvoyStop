{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/server/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
